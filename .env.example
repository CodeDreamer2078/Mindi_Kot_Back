PORT=5000
# Optional. Leave unset for dual-stack localhost (Windows-friendly).
# Set HOST=0.0.0.0 on Render/Railway if required.
# HOST=0.0.0.0
# Comma-separated allowed frontend origins (local + Vercel)
CLIENT_URL=http://localhost:5173,https://YOUR-FRONTEND.vercel.app
RECONNECT_TIMEOUT_MS=60000
ROOM_INACTIVE_MS=1800000
